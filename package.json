{
  "name": "kala",
  "version": "1.0.0",
  "description": "Kala monorepo containing web (React) and api (NestJS) applications for a live creative learning marketplace.",
  "scripts": {
    "dev": "doppler run -- pnpm -r --parallel dev",
    "dev:api": "doppler run -- pnpm --filter api dev",
    "dev:web": "doppler run -- pnpm --filter web dev",
    "dev:docker": "doppler run -- docker compose up",
    "prisma:studio": "doppler run -- pnpm --filter api exec prisma studio",
    "prisma:migrate": "doppler run -- pnpm --filter api exec prisma migrate dev",
    "lint:api": "pnpm --filter api lint",
    "lint:web": "pnpm --filter web lint",
    "lint": "biome lint .",
    "lint:fix": "biome lint --write .",
    "format": "biome format --write .",
    "check": "biome check ."
  },
  "author": "Fathima",
  "license": "ISC",
  "pnpm": {
    "onlyBuiltDependencies": [
      "@nestjs/core",
      "@openapitools/openapi-generator-cli",
      "@prisma/client",
      "@prisma/engines",
      "@scarf/scarf",
      "bcrypt",
      "esbuild",
      "prisma",
      "unrs-resolver"
    ]
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.4"
  }
}

# ───────────────────────────────────────────────────
# Kala API — Environment Variables Reference
# ───────────────────────────────────────────────────

# App
PORT=4000
CORS_ORIGINS=http://localhost:5173
NODE_ENV=development
LOG_LEVEL=debug

# Database (Postgres)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=kala
DATABASE_URI=postgresql://postgres:postgres@localhost:5433/kala

# Redis
REDIS_PASSWORD=redis
REDIS_URI=redis://localhost:6379

# Admin Seed
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=change_this_in_doppler

# Email / SMTP
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=no-reply@kala.local

# OTP
OTP_TTL_SECONDS=600
OTP_RESEND_COOLDOWN_SECONDS=60

# Auth Secrets (32+ chars)
ACCESS_TOKEN_SECRET=
REFRESH_TOKEN_SECRET=
ACCESS_TOKEN_EXPIRES_IN=15m
REFRESH_TOKEN_EXPIRES_IN=7d
REFRESH_COOKIE_NAME=refreshToken
COOKIE_SECURE=false
COOKIE_SAME_SITE=lax
COOKIE_DOMAIN=

# OAuth
GOOGLE_CLIENT_ID=

# Password Reset
PASSWORD_RESET_TTL_SECONDS=900
PASSWORD_RESET_URL=http://localhost:5173/reset-password

# AWS S3
AWS_REGION=eu-north-1
AWS_S3_BUCKET=kala-media-dev
AWS_S3_UPLOAD_URL_TTL_SECONDS=300
AWS_S3_DOWNLOAD_URL_TTL_SECONDS=900
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# Booking & Slots
SLOT_DEFAULT_TIMEZONE=Asia/Kolkata
SLOT_GENERATION_DAYS=90
BOOKING_HOLD_TTL_SECONDS=600
BOOKING_LOCK_TIMEOUT_MS=3000

# Payments (Razorpay)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
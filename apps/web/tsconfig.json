{
  "compilerOptions": {
    "target": "ES2020",
    "useDefineForClassFields": true,
    "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "skipLibCheck": true,
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "jsx": "react-jsx",
    "strict": true,
    "noUnusedLocals": false,
    "noUnusedParameters": false,
    "noFallthroughCasesInSwitch": true,
    "paths": {
      "@/*": ["./src/*"]
    }
  },
  "include": ["src"],
  "exclude": [
    "src/pages/instructor/Payments.tsx",
    "src/pages/instructor/ProfileSettings.tsx",
    "src/pages/instructor/Reviews.tsx",
    "src/pages/instructor/SessionChat.tsx",
    "src/pages/student/BookingChat.tsx",
    "src/pages/student/PaymentHistory.tsx",
    "src/pages/student/VideoCall.tsx",
    "src/components/shared/InstructorCard.tsx",
    "src/components/shared/ReviewCard.tsx",
    "src/components/shared/SkillCard.tsx",
    "src/components/shared/SlotCard.tsx"
  ],
  "references": [{ "path": "./tsconfig.node.json" }]
}
